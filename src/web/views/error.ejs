<section class="card narrow center">
  <p class="eyebrow">Error <%= code %></p>
  <h1><%= code === 404 ? 'Not found' : code === 403 ? 'Not allowed' : 'Something went wrong' %></h1>
  <p class="muted"><%= message %></p>
  <p><a class="btn" href="<%= user ? '/claims' : '/' %>">Go back home</a></p>
</section>
