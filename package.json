{
  "name": "spendwise",
  "version": "0.1.0",
  "description": "Receipt and expense approvals for small teams, run from Claude.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/db/migrate.js && exec node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "check:no-ai": "node scripts/check-no-ai.js",
    "start:server": "node dist/server.js",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:prod": "node dist/db/seed.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.36.0",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "multer": "^2.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.14.0",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
