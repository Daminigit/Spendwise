# ── App ───────────────────────────────────────────────────────
# Full Postgres connection string (Neon / Render / local)
DATABASE_URL=postgresql://user:password@localhost:5432/spendwise

# Secret for signing session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=change_me_before_deploy

# Public URL of this deployment (no trailing slash). Optional on Render,
# where RENDER_EXTERNAL_URL is used automatically.
APP_URL=http://localhost:3000

# ── File Storage (Cloudflare R2 or any S3-compatible) ──────────
# Leave blank in dev to use local disk (./uploads/, or UPLOADS_DIR).
# The bucket can (and should) stay PRIVATE: receipts are streamed through
# the app at /receipts/<file> after a permission check, never linked directly.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# UPLOADS_DIR=./uploads

# ── Demo data ─────────────────────────────────────────────────
# true = seed the "Acme Travel" demo org on boot if it doesn't exist yet
SEED_DEMO=false
# Optional fixed connector token for the demo user Riya (sw_ + 20+ url-safe chars)
DEMO_MCP_TOKEN=

# ── Tests ─────────────────────────────────────────────────────
# Integration tests ONLY use this database (never DATABASE_URL); skipped if unset
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/spendwise_test

# ── Dev helpers ───────────────────────────────────────────────
# Set to 'sqlite' to use a local SQLite file instead of Postgres
DB_DRIVER=postgres
NODE_ENV=development
PORT=3000

