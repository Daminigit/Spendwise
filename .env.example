# ── App ───────────────────────────────────────────────────────
# Full Postgres connection string (Neon / Render / local). On Neon use the
# pooled URL here; `neon deploy` writes it to .env.local, which is loaded first.
DATABASE_URL=postgresql://user:password@localhost:5432/spendwise
# Optional direct (non-pooled) URL for migrations, e.g. Neon's DATABASE_URL_UNPOOLED
DATABASE_URL_UNPOOLED=

# Secret for signing session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=change_me_before_deploy

# Public URL of this deployment (no trailing slash). Optional on Render,
# where RENDER_EXTERNAL_URL is used automatically.
APP_URL=http://localhost:3000

# ── Receipt storage ───────────────────────────────────────────
# Default: receipt images are stored in Postgres (one database for everything).
# RECEIPT_STORAGE=disk stores them in ./uploads (or UPLOADS_DIR) instead.
RECEIPT_STORAGE=database
# Optional private S3-compatible bucket (e.g. Cloudflare R2); overrides the above when set.
# The bucket can (and should) stay PRIVATE: receipts are streamed through
# the app at /receipts/<file> after a permission check, never linked directly.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# UPLOADS_DIR=./uploads

# ── Demo data ─────────────────────────────────────────────────
# true = seed the "Acme Travel" demo org on boot if it doesn't exist yet
SEED_DEMO=false
# Optional fixed connector token for the demo user Riya (sw_ + 20+ url-safe chars)
DEMO_MCP_TOKEN=

# ── Tests ─────────────────────────────────────────────────────
# Integration tests ONLY use this database (never DATABASE_URL); skipped if unset.
# Use a throwaway database: tests create (and reset the demo) data in it.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/spendwise_test

# ── Dev helpers ───────────────────────────────────────────────
# Set to 'sqlite' to use a local SQLite file instead of Postgres
DB_DRIVER=postgres
NODE_ENV=development
PORT=3000

